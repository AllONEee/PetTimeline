import SwiftUI
import SwiftData

/// 时间轴单条事件卡片
/// - 左侧垂直时间线（始终存在、连续竖线 + 类型色圆点）
/// - 卡片无灰色背景，右上角三个点菜单：编辑照片 / 添加记录
/// - 照片展示采用「档案堆叠」：主图在前，其余照片错开叠在主图右后方
/// - 左滑主图 -> 右后方第一张放大成为主图，原主图退到最底层
/// - 点击主图进入全屏预览
/// - 左滑卡片删除，级联删除关联照片
struct TimelineRow: View {
    @Environment(\.modelContext) private var modelContext
    let event: TimelineEvent
    let onDelete: () -> Void

    @State private var selectedPhotoIndex = 0
    @State private var showDeleteError = false
    @State private var deleteErrorMessage = ""
    @State private var showPhotoPreview = false
    @State private var showPhotoEditor = false
    @State private var showRecordEditor = false

    private let dotColumnWidth: CGFloat = 14
    private let lineWidth: CGFloat = 2

    var body: some View {
        HStack(alignment: .top, spacing: 12) {
            // 左侧时间线：圆点（始终存在）
            VStack(spacing: 0) {
                Circle()
                    .fill(event.eventType.color)
                    .frame(width: 14, height: 14)
                    .padding(.top, 14)
                    .overlay(
                        Circle()
                            .stroke(Color(uiColor: .secondarySystemBackground), lineWidth: 2)
                    )
                Spacer()
            }
            .frame(width: dotColumnWidth)

            card
        }
        // 贯穿整行的连续竖线，与圆点对齐
        .overlay(alignment: .topLeading) {
            Rectangle()
                .fill(Color.secondary.opacity(0.25))
                .frame(width: lineWidth)
                .frame(maxHeight: .infinity)
                .offset(x: (dotColumnWidth - lineWidth) / 2, y: 14)
        }
        .swipeActions(edge: .trailing, allowsFullSwipe: true) {
            Button(role: .destructive) {
                onDelete()
            } label: {
                Label("删除", systemImage: "trash")
            }
        }
        .alert("删除失败", isPresented: $showDeleteError) {
            Button("好", role: .cancel) {}
        } message: {
            Text(deleteErrorMessage)
        }
        // 全屏预览
        .fullScreenCover(isPresented: $showPhotoPreview) {
            PhotoPreviewView(photos: event.photos, startIndex: selectedPhotoIndex)
        }
        // 照片编辑页（由三点菜单进入）
        .fullScreenCover(isPresented: $showPhotoEditor) {
            if let photoData = event.photos[safe: selectedPhotoIndex]?.imageData {
                PhotoEditorView(imageData: photoData) { editedData in
                    updateEventPhoto(editedData)
                }
            }
        }
        // 当天事件编辑页（由三点菜单进入）
        .sheet(isPresented: $showRecordEditor) {
            AddRecordView(event: event)
        }
    }

    // MARK: - 卡片

    private var card: some View {
        VStack(alignment: .leading, spacing: 10) {
            // 头部：日期 + 图标 + 三个点菜单（独立命中区域，不会把点击透给照片区）
            header
                .zIndex(1)

            if !event.title.isEmpty {
                Text(event.title)
                    .font(.headline)
                    .foregroundStyle(.primary)
                    .lineLimit(2)
            }

            if !event.content.isEmpty {
                Text(event.content)
                    .font(.subheadline)
                    .foregroundStyle(.secondary)
                    .lineLimit(3)
            }

            if let location = event.locationName, !location.isEmpty {
                Label(location, systemImage: "location.fill")
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }

            if !event.photos.isEmpty {
                PhotoStackView(
                    photos: event.photos,
                    selectedIndex: $selectedPhotoIndex,
                    onMainImageTap: {
                        showPhotoPreview = true
                    }
                )
            }
        }
        .padding(14)
        .frame(maxWidth: .infinity, alignment: .leading)
        .contentShape(Rectangle())
    }

    private var header: some View {
        HStack(alignment: .top, spacing: 8) {
            // 日期 + 事件类型图标
            HStack(spacing: 6) {
                Image(systemName: event.eventType.iconName)
                    .font(.caption)
                    .foregroundStyle(event.eventType.color)

                Text(event.date.displayDateString)
                    .font(.subheadline.weight(.medium))
                    .foregroundStyle(.primary)
            }

            Spacer(minLength: 8)

            // 右上角三个点菜单
            // 显式命中区域 + 独立 zIndex，保证点击必定弹出菜单而不是照片预览
            Menu {
                Button {
                    editEventPhotos()
                } label: {
                    Label("编辑照片", systemImage: "photo.on.rectangle.angled")
                }
                Button {
                    addEventRecord()
                } label: {
                    Label("添加记录", systemImage: "plus.circle")
                }
            } label: {
                Image(systemName: "ellipsis.circle")
                    .font(.system(size: 20))
                    .foregroundStyle(.secondary)
                    .frame(width: 34, height: 34)
                    .contentShape(Rectangle())
            }
            .buttonStyle(.plain)
            .menuOrder(.fixed)
            .accessibilityLabel("更多操作")
        }
    }

    // MARK: - 操作

    private func editEventPhotos() {
        if event.photos[safe: selectedPhotoIndex] != nil {
            showPhotoEditor = true
        }
    }

    private func addEventRecord() {
        showRecordEditor = true
    }

    private func updateEventPhoto(_ newImageData: Data) {
        if let index = event.photos.firstIndex(where: { $0.id == event.photos[selectedPhotoIndex].id }) {
            event.photos[index].imageData = newImageData
            try? modelContext.save()
        }
    }

    func deleteEvent() {
        do {
            modelContext.delete(event)
            try modelContext.save()
        } catch {
            deleteErrorMessage = error.localizedDescription
            showDeleteError = true
        }
    }
}

// MARK: - 档案式照片堆叠

/// 照片「档案堆叠」视图
/// - 主图在最前（白边 + 阴影）
/// - 其余照片按深度逐层向右下方错开，深度越大越靠后、越小
/// - 左滑主图：深度 1（右后第一张）上浮成为主图，原主图退到最底层
/// - 右滑主图：最底层照片与主图对调
/// - 点击后方卡片：该照片直接上浮为主图
struct PhotoStackView: View {
    let photos: [EventPhoto]
    @Binding var selectedIndex: Int
    let onMainImageTap: () -> Void

    private let mainHeight: CGFloat = 220
    private let depthStep: CGFloat = 14
    private let sideStep: CGFloat = 5
    private let maxVisibleDepth = 3
    private let swipeThreshold: CGFloat = 60

    @State private var dragOffset: CGFloat = 0

    /// 照片总数
    private var count: Int { photos.count }

    /// 深度 X（1 = 紧贴主图之后）对应的照片下标
    private func index(atDepth depth: Int) -> Int {
        (selectedIndex + depth) % count
    }

    /// 可见深度集合（从最深层到最浅层，保证浅层绘制在上方）
    private var visibleDepths: [Int] {
        guard count > 1 else { return [] }
        let deepest = min(count - 1, maxVisibleDepth)
        return Array((1...deepest).reversed())
    }

    var body: some View {
        ZStack(alignment: .center) {
            if count == 1 {
                mainCard(photos[0], depth: 0)
            } else {
                // 后方档案卡片
                ForEach(visibleDepths, id: \.self) { depth in
                    let index = index(atDepth: depth)
                    stackCard(photos[index], depth: depth, index: index)
                }

                // 主图
                mainCard(photos[selectedIndex], depth: 0)
                    .offset(x: dragOffset)
                    .gesture(
                        DragGesture(minimumDistance: 24)
                            .onChanged { value in
                                // 只响应横向拖拽，纵向留给列表滚动
                                if abs(value.translation.width) > abs(value.translation.height) {
                                    dragOffset = value.translation.width
                                }
                            }
                            .onEnded { value in
                                let width = value.translation.width
                                let horizontal = abs(width) > abs(value.translation.height)
                                let target = selectedIndex

                                withAnimation(.spring(response: 0.35, dampingFraction: 0.82)) {
                                    dragOffset = 0
                                    if horizontal && width < -swipeThreshold {
                                        // 左滑 -> 右后第一张上浮，原主图退到最后
                                        selectedIndex = (target + 1) % count
                                    } else if horizontal && width > swipeThreshold {
                                        // 右滑 -> 最底层照片上浮为主图
                                        selectedIndex = (target - 1 + count) % count
                                    }
                                }
                            }
                    )
            }
        }
        .frame(height: mainHeight + depthStep + 24)
        .frame(maxWidth: .infinity)
        .padding(.horizontal, sideStep * 2)
    }

    // MARK: 主图卡片

    private func mainCard(_ photo: EventPhoto, depth: Int) -> some View {
        cardContent(photo)
            .frame(height: mainHeight)
            .clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))
            .overlay(
                RoundedRectangle(cornerRadius: 14, style: .continuous)
                    .strokeBorder(.white, lineWidth: 3)
            )
            .shadow(color: .black.opacity(0.18), radius: 10, x: 0, y: 5)
            .zIndex(1)
            .onTapGesture {
                onMainImageTap()
            }
    }

    // MARK: 后方档案卡片

    private func stackCard(_ photo: EventPhoto, depth: Int, index: Int) -> some View {
        cardContent(photo)
            .frame(height: stackHeight(for: depth))
            .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
            .overlay(
                RoundedRectangle(cornerRadius: 12, style: .continuous)
                    .strokeBorder(.white, lineWidth: 2.5)
            )
            .shadow(color: .black.opacity(0.10), radius: 4, x: 0, y: 2)
            .offset(x: stackOffsetX(for: depth), y: stackOffsetY(for: depth))
            .zIndex(-Double(depth))
            .onTapGesture {
                // 点击后方卡片 -> 该照片上浮为主图（原主图顺势退到对应位置）
                withAnimation(.spring(response: 0.35, dampingFraction: 0.82)) {
                    selectedIndex = index
                }
            }
    }

    private func stackHeight(for depth: Int) -> CGFloat {
        mainHeight - CGFloat(depth) * depthStep
    }

    private func stackOffsetX(for depth: Int) -> CGFloat {
        CGFloat(depth) * sideStep
    }

    private func stackOffsetY(for depth: Int) -> CGFloat {
        CGFloat(depth) * depthStep * 0.5
    }

    // MARK: 图片内容

    private func cardContent(_ photo: EventPhoto) -> some View {
        Group {
            if let uiImage = UIImage(data: photo.imageData) {
                Image(uiImage: uiImage)
                    .resizable()
                    .aspectRatio(contentMode: .fill)
                    .frame(maxWidth: .infinity)
            } else {
                Rectangle()
                    .fill(Color.gray.opacity(0.25))
                    .frame(maxWidth: .infinity)
                    .overlay {
                        Image(systemName: "photo")
                            .foregroundStyle(.secondary)
                    }
            }
        }
    }
}

// MARK: - 全屏照片预览

struct PhotoPreviewView: View {
    let photos: [EventPhoto]
    let startIndex: Int
    @Environment(\.dismiss) private var dismiss
    @State private var currentIndex: Int

    init(photos: [EventPhoto], startIndex: Int) {
        self.photos = photos
        self.startIndex = startIndex
        _currentIndex = State(initialValue: startIndex)
    }

    var body: some View {
        ZStack(alignment: .top) {
            TabView(selection: $currentIndex) {
                ForEach(Array(photos.enumerated()), id: \.offset) { index, photo in
                    Image(uiImage: UIImage(data: photo.imageData) ?? UIImage())
                        .resizable()
                        .scaledToFit()
                        .tag(index)
                }
            }
            .tabViewStyle(.page)
            .ignoresSafeArea()
            .background(Color.black)
            .overlay(alignment: .topTrailing) {
                Button {
                    dismiss()
                } label: {
                    Image(systemName: "xmark.circle.fill")
                        .font(.system(size: 28))
                        .foregroundColor(.white)
                        .opacity(0.8)
                }
                .padding()
            }
            .onAppear { currentIndex = startIndex }
        }
    }
}

/// 单张照片缩略图（保留供其他可能用到的地方）
struct PhotoThumbnailView: View {
    let imageData: Data

    var body: some View {
        Group {
            if let uiImage = UIImage(data: imageData) {
                Image(uiImage: uiImage)
                    .resizable()
                    .aspectRatio(contentMode: .fill)
            } else {
                Rectangle()
                    .fill(Color.gray.opacity(0.25))
                    .overlay {
                        Image(systemName: "photo")
                            .foregroundStyle(.secondary)
                    }
            }
        }
        .frame(width: 84, height: 84)
        .clipShape(RoundedRectangle(cornerRadius: 10, style: .continuous))
    }
}

/// 安全数组下标
extension Array {
    subscript(safe index: Int) -> Element? {
        return indices.contains(index) ? self[index] : nil
    }
}
